v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
P 4 5 -140 -140 140 -140 140 140 -140 140 -140 -140 {}
T {sync_register_bit} -120 -125 0 0 0.25 0.25 {}
T {@name} 90 -160 0 0 0.2 0.2 {}
B 5 -162.5 -77.5 -157.5 -72.5 {name=D dir=in}
L 4 -160 -75 -140 -75 {}
T {D} -130 -80 0 0 0.19 0.19 {}
B 5 -162.5 -27.5 -157.5 -22.5 {name=EN dir=in}
L 4 -160 -25 -140 -25 {}
T {EN} -130 -30 0 0 0.19 0.19 {}
B 5 -162.5 22.5 -157.5 27.5 {name=CLK dir=in}
L 4 -160 25 -140 25 {}
T {CLK} -130 20 0 0 0.19 0.19 {}
B 5 -162.5 72.5 -157.5 77.5 {name=RESET dir=in}
L 4 -160 75 -140 75 {}
T {RESET} -130 70 0 0 0.19 0.19 {}
B 5 157.5 -2.5 162.5 2.5 {name=Q dir=out}
L 4 160 0 140 0 {}
T {Q} 30 -5 0 0 0.19 0.19 {}
B 5 -2.5 -162.5 2.5 -157.5 {name=VDD dir=inout}
L 4 0 -160 0 -140 {}
T {VDD} 10 -130 0 0 0.19 0.19 {}
B 5 -2.5 157.5 2.5 162.5 {name=VSS dir=inout}
L 4 0 160 0 140 {}
T {VSS} 10 130 0 0 0.19 0.19 {}
